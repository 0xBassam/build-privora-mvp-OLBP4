# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://privora:privora_secret@localhost:5432/privora_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=privora_db
DB_USER=privora
DB_PASSWORD=privora_secret

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@privora.sa
SMTP_PASS=your_smtp_password
EMAIL_FROM="Privora <no-reply@privora.sa>"

# ─── Encryption ───────────────────────────────────────────────────────────────
# Must be exactly 32 characters for AES-256
ENCRYPTION_KEY=change_me_32_char_encryption_key!

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
OTP_RATE_LIMIT_MAX=5
